# --- Django core ---
DJANGO_ENV=local                      # "local" or "production"
DEBUG=True
DJANGO_SECRET_KEY=
# --- Password pepper (versioned) ---
# A second secret, mixed into every password before it is hashed, so a leaked
# database is useless without the environment too. Kept apart from
# DJANGO_SECRET_KEY on purpose: rotating either must not touch the other.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# To rotate, ADD the next number and keep the old one; users are verified
# under the version their row records and re-hashed under the current one
# the next time they sign in. Remove an old pepper only when
# `python manage.py pepper_status` reports no rows left on it. Required in
# every environment - the server refuses to boot with none set. See
# "Password pepper" in the README.
PASSWORD_PEPPER_1=
# PASSWORD_PEPPER_2=
# PASSWORD_PEPPER_CURRENT_VERSION=2    # defaults to the highest number set
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
IS_DEPLOYED=False

# --- Database (MySQL) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
USE_SQLITE=False                      # local-only convenience toggle

# --- Cache (Redis) ---
# Leave blank to use Django's built-in in-memory cache. Fill it in and the
# whole project switches to Redis on the next restart - nothing to migrate,
# nothing to run. Note that the in-memory fallback is per worker process, so
# a cache invalidation only reaches the worker that made it; Redis is shared
# by all of them. See the CACHES block in config/settings/base.py.
#   local:    redis://127.0.0.1:6379/1
#   managed:  rediss://default:password@host:port/0     (rediss = TLS)
REDIS_URL=

# --- JWT ---
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=31

# --- Google Sign-In ---
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# --- CORS / CSRF ---
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5173
CSRF_TRUSTED_ORIGINS=

# --- Cloudinary (media storage) ---
# Cloudinary accounts are numbered so a new one can be added when the free
# tier fills up - see "Cloudinary Multi-Account Setup" in the README. New
# uploads go to CLOUDINARY_CURRENT_VERSION (default: the highest number);
# existing images stay on the account that holds them. The un-numbered trio
# below is read as version 1 for deployments that predate the numbering.

# CLOUDINARY_CLOUD_NAME_1=
# CLOUDINARY_API_KEY_1=
# CLOUDINARY_API_SECRET_1=

# CLOUDINARY_CLOUD_NAME_2=
# CLOUDINARY_API_KEY_2=
# CLOUDINARY_API_SECRET_2=

# CLOUDINARY_CURRENT_VERSION=2

CLOUDINARY_CLOUD_NAME_1=
CLOUDINARY_API_KEY_1=
CLOUDINARY_API_SECRET_1=

CLOUDINARY_CURRENT_VERSION=1

# --- URLs ---
FRONTEND_URL=
# The public base URL of THIS API. Every link we email - invitation
# activation, email-change confirmation - is built from it, so whatever you
# put here is what lands in the recipient's inbox. Leave it on localhost for
# development and a locally-triggered email links back to your own server.
# Defaults to http://127.0.0.1:8000; a deployed instance MUST override it
# (production.py refuses to boot on localhost when IS_DEPLOYED=True).
BACKEND_URL=http://127.0.0.1:8000

# --- Email (SMTP) ---
# The host/port/TLS apply to EVERY sender; only the login differs per tenant.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_USE_SSL=
# The PLATFORM mailbox: what a superuser's mail goes out through, and the
# fallback for any school or institute that has not set up its own sender
# in the console (School / Institute -> "Email sender"). Those per-tenant
# values live in the database; the app password is encrypted under
# EMAIL_SECRETS_KEY below.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Encrypts the per-school / per-institute app passwords at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotate with EMAIL_SECRETS_KEY=<new>,<old> (first encrypts, all decrypt).
# Blank locally derives one from DJANGO_SECRET_KEY; production refuses that.
EMAIL_SECRETS_KEY=
# Send transactional mail on a background thread (default True). Set False to
# make every send synchronous - useful when debugging SMTP.
EMAIL_SEND_ASYNC=True

# --- Email branding ---
# Emails are branded with the SCHOOL of the account they concern (the inviting
# staff member's school for invitations, the recipient's for everything else).
# These are the fallbacks for accounts that have no school attached.
EMAIL_BRAND_NAME=Codex Systems Api
# Accent colour of the email templates and the pages their links land on.
EMAIL_BRAND_COLOR=#04932a
# Shown as the "need help?" address in email footers; defaults to the sender.
SUPPORT_EMAIL=
# Logo in the email header for mail that belongs to no school or institute
# (a superuser's). Tenant mail uses the institute's Cloudinary logo, then
# the school's. An absolute https URL.
EMAIL_BRAND_LOGO_URL=

# --- Invitations ---
# Mail a one-time password with each invitation so a new user can sign in
# straight away. Off means the account is created with no usable password and
# the user has to go through "forgot password" first.
INVITE_SEND_TEMPORARY_PASSWORD=True
INVITE_TEMPORARY_PASSWORD_LENGTH=12
INVITE_EXPIRY_DAYS=3

# --- Email change (self-service, api/change_email) ---
# Step 1 mails a code to the CURRENT address; step 3 mails a link to the NEW
# one. User.email is only written when that link is opened.
EMAIL_CHANGE_OTP_LENGTH=6
EMAIL_CHANGE_OTP_EXPIRY_MINUTES=10
EMAIL_CHANGE_TOKEN_EXPIRY_MINUTES=15
# Longer on purpose: the recipient may have to go and sign in to that inbox.
EMAIL_CHANGE_CONFIRM_EXPIRY_MINUTES=60
EMAIL_CHANGE_MAX_ATTEMPTS=5

# --- API docs (drf-spectacular) ---
API_TITLE=DNSC SYSTEMS API
API_DESCRIPTION=This API powers the backend for our system.
API_CONTACT_URL=https://www.facebook.com/dnscicsa
API_CONTACT_EMAIL=alexarnaizaparece@gmail.com

# --- Production hardening (only read in production.py) ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000


# --- Feature flags: what this BUILD ships ---
# These are the kill switch, not the day-to-day toggle. False here means the
# module is not in this deployment at all: its routes are never registered (so
# they 404), its permissions are never granted, and no institute can turn it
# back on. Changing one needs a restart, because Django builds its URL table
# once at boot. Values are the exact strings "True" or "False".
#
# The day-to-day toggle lives in the database, per institute: a
# `feature_<name>` row in System Settings, editable from the settings page,
# in effect on the next request. Leave these True unless you genuinely want
# the module gone from the deployment, and let institutes choose.
#
# An institute with no row inherits the value here, so a fresh deployment
# behaves exactly as these say until somebody writes one. `seed_system_settings`
# writes the rows at these defaults.
#
# Not every institute may run every module - see RESTRICTED_TO_ACRONYMS in
# core/features.py. The contribution scheme is limited to the institute that
# built it, so turning it on here offers it only to them.
#
# The frontend has no feature variables of its own. It reads the resolved
# flags from the settings rows this API serves, and assumes every module is
# off until they arrive - so switching one on needs no new bundle.
#
# Student reports, recommendations and complaints-about-the-software.
FEATURE_CONTRIBUTIONS=True
# The reward half: points, wallets, the ranking, points-funded fee discounts.
# Off with FEATURE_CONTRIBUTIONS on means students still file reports and
# staff still review them - approvals simply pay nothing.
FEATURE_CONTRIBUTION_POINTS=True
# Student complaints (a mis-issued fee, a payment that never landed) and the
# staff workflow that answers them. Independent of the two above: a complaint
# is a service obligation, not a contribution, and never earns points.
FEATURE_COMPLAINTS=True
# Coupons: relief the institute hands out at events, redeemed against a fee.
# Independent of the contribution scheme - a fee can carry one of each.
#
# Off by default: a deployment opts in to handing out money. Note this is now
# the *build* switch - while it is False the module has no routes and no
# System Settings toggle, so an institute cannot enable it however much it
# wants to. Set it True once to ship the module; after that each institute
# turns it on and off from the settings page, with no further deploys.
FEATURE_COUPONS=False

# --- Live systems ---
# Which systems on this platform have a frontend that reads their settings.
# Comma-separated; one of collection, locker, attendance, clearance, voting.
#
# `seed_system_settings` writes maintenance switches only for these, for the
# same reason FEATURE_* gates the module rows above: a switch for an app
# nobody has built yet does nothing when somebody flips it, and the settings
# page gives no hint of that. Add a system the day its app ships; run
# `seed_system_settings --prune` to remove the rows for one taken back off.
LIVE_SYSTEMS=collection
